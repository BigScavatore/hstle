{
  "name": "hstle-desktop",
  "version": "0.1.0",
  "description": "Hstle desktop: il client web in una finestra, con condivisione di schermo e audio di sistema",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "it.hstle.desktop",
    "productName": "Hstle",
    "files": [
      "main.js",
      "preload.js",
      "preload-app.js",
      "picker.html",
      "server.html",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/application-loopback/bin/**"
    ],
    "artifactName": "Hstle-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.social-networking",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Network",
      "maintainer": "BigScavatore"
    }
  },
  "dependencies": {
    "application-loopback": "^1.2.7"
  },
  "author": "BigScavatore",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigScavatore/hstle.git"
  }
}
